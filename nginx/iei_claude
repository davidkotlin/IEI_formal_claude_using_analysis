server {
    listen 80;
    #server_name _;
    #client_max_body_size 200M;
    # http2協定
    listen 443 ssl http2;
    server_name _;
    client_max_body_size 200M;
    ssl_certificate /etc/ssl/certs/iei_claude.crt;
    ssl_certificate_key /etc/ssl/private/iei_claude.key;
    # 前端靜態檔案
    location / {
        root /opt/IEI_claude_using_analysis/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # 後端 API
    location /api/ {
        proxy_pass http://backend:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
